<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desenho dos documentos impressos (disposição em mm e impressão pelo spooler do Windows), partilhado pelo servidor
       e pelo agente de impressão dos postos: os dois imprimem exactamente igual. Sem dependências do resto do sistema. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
  </ItemGroup>

</Project>
