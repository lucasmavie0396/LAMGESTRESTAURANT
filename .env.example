# Exemplo de variáveis de ambiente para PRODUÇÃO (servidor central).
# O script scripts/instalar-servico.ps1 grava-as no serviço Windows; nunca fazer commit de valores reais.

# Connection string do SQL Server (só o backend a usa)
ConnectionStrings__Default=Server=NOME_SERVIDOR\INSTANCIA;Database=LAMGestRestaurantDB;Trusted_Connection=True;TrustServerCertificate=True

# Endereço/porta onde a API escuta na LAN (exemplo ilustrativo)
ASPNETCORE_URLS=http://0.0.0.0:8080

# Pasta protegida onde ficam as chaves que cifram as sessões (obrigatória em serviço Windows)
DataProtection__Pasta=C:\ProgramData\LAMGestRestaurant\chaves

# Com HTTPS configurado (ver docs/INSTALACAO_LAN.md), impede o cookie de sessão em HTTP simples
Seguranca__CookieSoHttps=false

# Origens permitidas para CORS — só necessário se o frontend for servido noutro endereço (normalmente vazio)
# Cors__AllowedOrigins__0=http://192.168.1.10:8080

ASPNETCORE_ENVIRONMENT=Production
